{
  // 本文件可直接 `cp config.example.json config.json` 使用：// 与 /* */ 注释会被忽略。
  // api_key 必填（也可用环境变量 CA2A_API_KEY）：没有 key 服务会拒绝启动。
  // 生成：openssl rand -hex 24
  "api_key": "",
  "listen": ":7866",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "default_model": "glm-5.2",
  "oauth_callback_host": "",
  "cooldown": {
    "soft_rate": "60s",
    "err_threshold": 3,
    "err_cooldown": "10m"
  },
  "benefit_auto_claim": true,    // 模型发现时自动领取限时福利（幂等；关闭则福利模型调用必然失败）
  "credits_auto_claim": true,    // watchdog 自动领取每日签到/新手活动积分；与模型 Token 福利独立
  // "login_client_id": "codearts-agent",  // WebUI 登录用 OAuth client；留空自动沿用已有账号的取值
  "max_concurrent": 1,           // 单账号最大并发数（默认 1，最稳避免撞上游 3 会话上限）
  "queue_retry_seconds": 10,     // 上游排队限流时的重试间隔秒数（默认 10）
  "queue_max_attempts": 30,      // 上游排队限流时的最大尝试次数（默认 30）
  "keepalive_window": "10m",     // 保活心跳窗口，超过此时间无活动则发送心跳（默认 10m）
  "watch": {
    "enabled": true,
    "poll_minutes": 30,
    "refresh_skew_minutes": 30,
    "keepalive_interval_minutes": 15  // 保活心跳间隔（新增，默认 15m）
  },
  "upstream": {
    "timeout_seconds": 120
  },
  "observability": {
    "enabled": true,
    "sqlite_path": "./data/observability.db",
    "retention_days": 30,
    "max_rows": 200000,
    "max_db_bytes": 134217728,
    "snapshot_interval_seconds": 60
  }
}
